/**
 * GYH_PowderSplit_MR.js
 *
 * Companion processor for GYH_PowderSplit_SL.js. All record writes happen
 * here so a batch of parts does not blow the 1,000-unit Suitelet governance
 * ceiling.
 *
 * Modeled directly on the 101798 cutover done in PROD on 08/04/2026:
 *
 *   item 8641   101798        -> renamed  101798 - SV   (+ " SILVER VEIN" on
 *                                the display name).  Keeps its internal ID,
 *                                so inventory / history / where-used stay put.
 *   item 28530  101798        -> new copy, the bare child.
 *
 *   bom 1072    101798 BOM    -> RENAMED to 101798 - SV BOM. Stays on the
 *                                parent, so historical WOs still resolve to
 *                                the BOM record they were built against.
 *      rev 1320  101798 REV F        end-dated 08/02/2026 (left as history)
 *      rev 12790 101798 - SV BOM REV F   NEW, eff 08/03/2026:
 *                                    101798                    x1   WORK_ORDER
 *                                    PRIME AND POWDER COAT ... x1   PHANTOM
 *
 *   bom 10955   101798 BOM    -> NEW BOM for the child, holding a clone of
 *      rev 12789 101798 REV F      the last fab revision, same name, original
 *                                  11/01/2023 start date, no end date.
 *
 *   routing 3709 101798 Routing  -> REPOINTED from bom 1072 to bom 10955.
 *                                   Same name, same steps, same history.
 *   routing 10248 101798 - SV ROUTING -> NEW on bom 1072, one op:
 *                                   seq 9  POWDERCOAT  Hitch - Powder Coating
 *                                   PRIME AND POWDER-COAT (COST PER HANGER)
 *                                   run rate 0.5
 *   routing 878  101798 Routing-TECH_ONLY -> untouched (inactive, sub 4).
 *
 * The phantom BOM qty on 101798 rev 12790 was entered as 1 but should have
 * been 0.5 to match the run rate. Hangers and run rate are the same number by
 * definition, so this script derives both from a single input and cannot
 * reproduce that drift. 125 already-split parts in PROD have the mismatch.
 *
 * BUGFIX (08/2026): the child's new BOM must be created AFTER the fab BOM is
 * renamed off the "<origName> BOM" name, not before -- that name still
 * belongs to the (as-yet unrenamed) fab BOM at the point the old code tried
 * to reuse it, so createBom() collided with it on every single part. Fixed
 * by renaming the fab BOM first, which frees the name for the child's clone.
 *
 * RESUME SUPPORT: if a run dies after the rename+copy step but before the
 * BOM/routing rebuild (exactly what the ordering bug above caused), the item
 * split is already done and safe -- record.copy() carries the original BOM
 * assignment onto the child as a side effect, so both items still point at
 * the same untouched BOM/routing until the rebuild finishes. row.resume=true
 * skips the rename+copy and picks up directly at the BOM/routing rebuild
 * using row.parentInternalId (the already-renamed parent) and
 * row.itemInternalId (the already-created child).
 *
 * @NApiVersion 2.1
 * @NScriptType MapReduceScript
 * @NModuleScope SameAccount
 */
define(['N/record', 'N/query', 'N/runtime', 'N/log', 'N/format', 'N/email'],
(record, query, runtime, log, format, email) => {

  // ---------------------------------------------------------------- config
  // Verified against PROD account 5262266 on 2026-08-04.
  const CFG = {
    PARAM: 'custscriptgyh_pcs_payload',  // confirmed in SB2; resolved by label if absent
    PARAM_LABEL: 'Powder Split Payload', // used to resolve the real ID per account

    PC_OP_NAME: 'POWDERCOAT',   // 101798 used one word; older parts used "POWDER COAT"
    PC_OP_SEQ: 9,
    PC_WORKCENTER: 948410,      // entitygroup "Hitch - Powder Coating"
    PC_COST_TEMPLATE: 38,       // "PRIME AND POWDER-COAT (COST PER HANGER)"
    PC_SETUP_TIME: 0,

    SUBSIDIARY: 2,              // GEN-Y HITCH
    LOCATION: 1,                // Hitch
    COST_ESTIMATE_TYPE: 'AVGCOST',

    CHILD_ITEM_SOURCE: 'WORK_ORDER',
    PHANTOM_ITEM_SOURCE: 'PHANTOM',

    EMAIL_SUMMARY: true
  };

  // ------------------------------------------------------------------ input
  /**
   * Read the payload. The parameter's real ID is auto-assigned by NetSuite and
   * differs per account (SB2 ended up with "custscriptgyh_pcs_payload", not
   * the "custscript_gyh_pcs_payload" that was typed), so try the known ID
   * first and then fall back to resolving it by label.
   */
  const readPayload = () => {
    const script = runtime.getCurrentScript();

    let raw = null;
    try { raw = script.getParameter({ name: CFG.PARAM }); } catch (e) { /* not defined here */ }
    if (raw) return raw;

    let resolvedId = null;
    try {
      const p = query.runSuiteQL({
        query: 'SELECT scriptid FROM customfield ' +
               "WHERE fieldtype = 'SCRIPT' AND UPPER(name) = ? AND ROWNUM <= 1",
        params: [String(CFG.PARAM_LABEL).toUpperCase()]
      }).asMappedResults();
      if (p.length && p[0].scriptid) resolvedId = String(p[0].scriptid).toLowerCase();
    } catch (e) {
      log.audit('Parameter lookup by label failed', e.message);
    }

    if (resolvedId && resolvedId !== CFG.PARAM) {
      try {
        raw = script.getParameter({ name: resolvedId });
        if (raw) {
          log.audit('Payload read via resolved parameter ID', resolvedId);
          return raw;
        }
      } catch (e) { /* fall through to the error below */ }
    }

    throw new Error('No payload found on "' + CFG.PARAM + '"' +
      (resolvedId ? ' or "' + resolvedId + '"' : '') +
      '. Launch this from the Suitelet, and confirm the script parameter ' +
      '"' + CFG.PARAM_LABEL + '" exists as Long Text on this deployment.');
  };

  const getInputData = () => {
    const rows = JSON.parse(readPayload());
    log.audit('Powder split starting', rows.length + ' part(s)');
    return rows;
  };

  // -------------------------------------------------------------------- map
  const map = (ctx) => {
    const row = JSON.parse(ctx.value);
    const result = { partNumber: row.partNumber, ok: false, created: {}, error: null, notes: [] };
    try {
      splitPart(row, result);
      result.ok = true;
      log.audit('Split OK: ' + row.partNumber, result.created);
    } catch (e) {
      result.error = e.message || String(e);
      log.error('Split FAILED: ' + row.partNumber, e);
    }
    ctx.write({ key: row.partNumber, value: JSON.stringify(result) });
  };

  // ------------------------------------------------------------------- work
  const splitPart = (row, result) => {
    const origName   = String(row.partNumber).trim();
    const parentName = String(row.parentName).trim();
    const phantomId  = Number(row.phantomItemId);
    const colorText  = String(row.colorText || '').trim();
    const hangers    = Number(row.hangers);
    const runRate    = hangers;   // same number by definition -- see header note
    const fabBomId   = row.fabBomId ? Number(row.fabBomId) : null;
    const resume     = !!row.resume;

    const cutover = parseDate(row.cutoverDate);          // new parent rev starts here
    const dayBefore = addDays(cutover, -1);              // old fab rev ends here

    let origId, childId, baseText;

    if (resume) {
      // A prior attempt already renamed the parent and copied out the child
      // (record.copy() carries the original BOM assignment over as a side
      // effect, so both items still safely share the old, untouched BOM at
      // this point -- nothing is broken, just unfinished). Pick up from
      // there instead of renaming/copying again.
      origId = Number(row.parentInternalId);
      childId = Number(row.itemInternalId);
      const parentRec = record.load({ type: record.Type.ASSEMBLY_ITEM, id: origId, isDynamic: false });
      baseText = readDescriptions(parentRec, colorText);
      result.created.parentId = origId;
      result.created.parentName = parentName;
      result.created.childId = childId;
      result.created.childName = origName;
      result.notes.push('Resumed a prior attempt: item rename and child copy were already done; ' +
                        'only the BOM/routing rebuild ran this time.');
    } else {
      origId = Number(row.itemInternalId);

      // ------------------------------------------------ 1. rename the original
      const parent = record.load({ type: record.Type.ASSEMBLY_ITEM, id: origId, isDynamic: false });
      baseText = readDescriptions(parent, colorText);
      parent.setValue({ fieldId: 'itemid', value: parentName });
      // The color goes on ALL THREE description fields, matching PROD: on
      // 104655 - BK the display name, sales description and purchase
      // description all read "... Textured Black".
      applyDescriptions(parent, baseText, colorText);
      parent.setValue({ fieldId: 'costestimatetype', value: CFG.COST_ESTIMATE_TYPE });
      parent.save({ ignoreMandatoryFields: true });
      result.created.parentId = origId;
      result.created.parentName = parentName;

      // -------------------------------------------- 2. copy out the bare child
      const child = record.copy({ type: record.Type.ASSEMBLY_ITEM, id: origId, isDynamic: false });
      child.setValue({ fieldId: 'itemid', value: origName });
      applyDescriptions(child, baseText, '');   // bare part: no color
      child.setValue({ fieldId: 'costestimatetype', value: CFG.COST_ESTIMATE_TYPE });
      adjustChild(child);
      childId = child.save({ ignoreMandatoryFields: true });
      result.created.childId = childId;
      result.created.childName = origName;
    }

    // On resume the rename already happened but the descriptions may not have
    // been touched (the original run died before this was implemented), so
    // apply them now.
    if (resume && colorText) {
      try {
        const p = record.load({ type: record.Type.ASSEMBLY_ITEM, id: origId, isDynamic: false });
        applyDescriptions(p, baseText, colorText);
        p.save({ ignoreMandatoryFields: true });
        const c = record.load({ type: record.Type.ASSEMBLY_ITEM, id: childId, isDynamic: false });
        applyDescriptions(c, baseText, '');
        c.save({ ignoreMandatoryFields: true });
        result.notes.push('Descriptions back-filled with "' + colorText + '" on the parent.');
      } catch (e) {
        result.notes.push('Could not back-fill descriptions: ' + (e.message || e));
      }
    }

    if (!fabBomId) {
      result.notes.push('No master-default BOM on the original item. No child BOM built and ' +
                        'no routing repointed -- the powder BOM/routing below is all that was made.');
    }

    // ------------------------- 3. rename the fab BOM out of the way FIRST --
    //    it currently still holds the name "<origName> BOM" (e.g. "101320
    //    BOM"), which is exactly the name the child's new BOM needs below.
    //    Renaming this one to the parent name frees that name up. Doing
    //    this step AFTER creating the child's BOM (the old order) collided
    //    with this record's own pre-existing name on every single part.
    let childBomId = null;
    if (fabBomId) {
      const fabRevId = row.fabRevId ? Number(row.fabRevId) : getCurrentRevision(fabBomId, origId);
      if (!fabRevId) throw new Error('Could not resolve the current revision on BOM ' + fabBomId + '.');

      const srcRev = record.load({ type: record.Type.BOM_REVISION, id: fabRevId, isDynamic: false });
      const srcRevName = srcRev.getValue({ fieldId: 'name' });

      const bom = record.load({ type: record.Type.BOM, id: fabBomId, isDynamic: false });
      const fabSubs = getBomSubsidiaries(fabBomId);
      const alreadyRenamed = String(bom.getValue({ fieldId: 'name' })) === (parentName + ' BOM');
      if (!alreadyRenamed) {
        bom.setValue({ fieldId: 'name', value: parentName + ' BOM' });
        bom.save({ ignoreMandatoryFields: true });
      }
      result.created.parentBomId = fabBomId;

      // ------------------------- 4. now the original name is free: give the
      //    child its own clone of the fab revision under that name.
      childBomId = createBom(origName + ' BOM', fabSubs, [childId]);
      result.created.childBomId = childBomId;
      result.created.childRevisionId = cloneRevision(srcRev, childBomId);

      // the copy inherited the parent's BOM line -- swap it for the new one
      replaceBoms(childId, childBomId);

      // ----------------------- 5. repoint the live fab routing to that BOM
      const moved = repointRoutings(fabBomId, childBomId);
      result.created.routingsRepointed = moved;
      if (!moved.length) {
        result.notes.push('No active subsidiary-' + CFG.SUBSIDIARY + ' routing was on BOM ' +
                          fabBomId + ', so nothing was repointed to the child.');
      }

      // ------------------- 6. close the old rev, add the powder rev
      const revAlreadyEndDated = !!srcRev.getValue({ fieldId: 'effectiveenddate' });
      if (!revAlreadyEndDated) endDateRevision(fabRevId, dayBefore);

      const letter = revisionLetter(srcRevName);
      result.created.parentRevisionId = createPowderRevision(
        fabBomId, parentName + ' BOM REV ' + letter, cutover, childId, phantomId, hangers
      );
      result.created.parentRevisionName = parentName + ' BOM REV ' + letter;

      // ---------------------------------- 7. powder routing on the same BOM
      result.created.routingId = createRouting(parentName, fabBomId, runRate);

    } else {
      // No pre-existing BOM: build the powder BOM from scratch on the parent.
      // No source BOM to inherit from, so mirror the item's own subsidiaries.
      let itemSubs = null;
      try {
        const it = record.load({ type: record.Type.ASSEMBLY_ITEM, id: origId, isDynamic: false });
        const v = it.getValue({ fieldId: 'subsidiary' });
        itemSubs = Array.isArray(v) ? v
          : (v ? String(v).split(',').map((s) => s.trim()).filter((s) => s) : null);
      } catch (e) {
        log.audit('Could not read subsidiaries off item ' + origId, e.message);
      }
      const bomId = createBom(parentName + ' BOM', itemSubs, [origId]);
      result.created.parentBomId = bomId;
      result.created.parentRevisionName = parentName + ' BOM REV A';
      result.created.parentRevisionId = createPowderRevision(
        bomId, parentName + ' BOM REV A', cutover, childId, phantomId, hangers
      );
      attachBom(origId, bomId, true);
      result.created.routingId = createRouting(parentName, bomId, runRate);
    }
  };

  // ------------------------------------------------------- description fields
  // In PROD the color appears on all three of these. NetSuite field IDs:
  //   displayname         -> Display Name/Code
  //   salesdescription    -> Sales Order Description (SuiteQL: description)
  //   purchasedescription -> Purchase Description
  const DESC_FIELDS = ['displayname', 'salesdescription', 'purchasedescription'];

  /**
   * Read the base (color-free) description text off an item. Prefers
   * displayname, falls back to the others, and strips a trailing color if one
   * is already present so re-running can't double it up.
   */
  const readDescriptions = (rec, colorText) => {
    let base = '';
    for (let i = 0; i < DESC_FIELDS.length && !base; i++) {
      try { base = String(rec.getValue({ fieldId: DESC_FIELDS[i] }) || '').trim(); }
      catch (e) { /* field not present */ }
    }
    return stripColor(base, colorText);
  };

  /** Remove a trailing color name, with or without a separating comma. */
  const stripColor = (text, colorText) => {
    let out = String(text || '').trim();
    if (!colorText) return out;
    const esc = String(colorText).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    out = out.replace(new RegExp('[,\\s]*' + esc + '\\s*$', 'i'), '').trim();
    return out.replace(/,$/, '').trim();
  };

  /**
   * Write base text plus the color onto every description field. Passing an
   * empty colorText writes the bare text, which is what the child gets.
   */
  const applyDescriptions = (rec, baseText, colorText) => {
    const value = colorText ? (baseText + ' ' + colorText).trim() : baseText;
    DESC_FIELDS.forEach((f) => {
      try {
        const current = String(rec.getValue({ fieldId: f }) || '').trim();
        // only rewrite fields that actually carry the description, so a blank
        // purchase description stays blank rather than being invented
        if (current || f === 'displayname') {
          rec.setValue({ fieldId: f, value: value });
        }
      } catch (e) {
        log.audit('Could not set ' + f, e.message);
      }
    });
  };

  /**
   * Hook for anything the bare child should NOT inherit from the copy.
   * It is an internal WIP part, so it usually should not be sellable or
   * carry the parent's sales pricing.
   */
  const adjustChild = (child) => {
    try {
      // child.setValue({ fieldId: 'isonline', value: false });
      // child.setValue({ fieldId: 'salesdescription', value: '' });
      // child.setValue({ fieldId: 'upccode', value: '' });
    } catch (e) {
      log.audit('adjustChild skipped a field', e.message);
    }
  };

  // ----------------------------------------------------------- BOM plumbing
  const getCurrentRevision = (bomId, itemId) => {
    const r = query.runSuiteQL({
      query: 'SELECT currentrevision FROM itemAssemblyItemBom ' +
             'WHERE billofmaterials = ? AND assembly = ?',
      params: [bomId, itemId]
    }).asMappedResults();
    return r.length && r[0].currentrevision ? Number(r[0].currentrevision) : null;
  };

  /**
   * Create a BOM.
   *
   * `subsidiaries` should be the subsidiary list read off the BOM being cloned
   * -- these items commonly sit on BOTH GEN-Y HITCH (2) and GEN-Y TECH (4),
   * and every fab BOM checked in PROD and SB2 carries "2, 4". Hardcoding just
   * CFG.SUBSIDIARY would create the child BOM narrower than the parent it was
   * cloned from and break it for TECH-side activity.
   *
   * `assemblyIds` is REQUIRED in practice. A BOM saved with
   * availableforallassemblies = F and an empty restricttoassemblies is
   * available to NO assembly, so the later item-side assignment is rejected
   * with "Invalid Field Value <bomid> for the following field: billofmaterials".
   * Assigning from the item side does NOT back-fill this restriction -- the
   * BOM has to be made available to the assembly first. Every working fab BOM
   * in the account follows the same shape: allassemblies = F with the assembly
   * listed in restricttoassemblies.
   */
  const createBom = (name, subsidiaries, assemblyIds) => {
    // A prior failed attempt may have already created this BOM (it is created
    // before the assignment step that can fail). Reuse it instead of
    // colliding on the name -- and re-apply the availability settings, since
    // the earlier run is exactly what may have left them wrong.
    const existing = findBomByName(name);
    if (existing) {
      log.audit('Reusing BOM ' + existing + ' left by a prior attempt', name);
      try {
        const vals = {};
        if (assemblyIds && assemblyIds.length) {
          vals.availableforallassemblies = false;
          vals.restricttoassemblies = assemblyIds;
        }
        if (Object.keys(vals).length) {
          record.submitFields({
            type: record.Type.BOM, id: existing, values: vals,
            options: { ignoreMandatoryFields: true }
          });
        }
      } catch (e) {
        log.audit('Could not re-apply availability on reused BOM ' + existing, e.message);
      }
      return existing;
    }

    const bom = record.create({ type: record.Type.BOM, isDynamic: false });
    bom.setValue({ fieldId: 'name', value: name });
    bom.setValue({ fieldId: 'includechildren', value: false });
    bom.setValue({ fieldId: 'usecomponentyield', value: false });
    bom.setValue({ fieldId: 'availableforalllocations', value: true });  // must be T
    bom.setValue({
      fieldId: 'subsidiary',
      value: (subsidiaries && subsidiaries.length) ? subsidiaries : [CFG.SUBSIDIARY]
    });

    let restricted = false;
    if (assemblyIds && assemblyIds.length) {
      try {
        bom.setValue({ fieldId: 'availableforallassemblies', value: false });
        bom.setValue({ fieldId: 'restricttoassemblies', value: assemblyIds });
        restricted = true;
      } catch (e) {
        log.audit('Could not set restricttoassemblies on new BOM "' + name + '"', e.message);
      }
    }
    if (!restricted) {
      // Fallback: leave it open to all assemblies rather than saving a BOM
      // that is available to none, which would fail the item-side assignment.
      bom.setValue({ fieldId: 'availableforallassemblies', value: true });
      log.audit('BOM "' + name + '" saved as available-for-all-assemblies',
                'restricttoassemblies could not be set; assignment would otherwise fail.');
    }

    return bom.save({ ignoreMandatoryFields: true });
  };

  /** Find a BOM by exact name, or null. Used to recover from partial runs. */
  const findBomByName = (name) => {
    try {
      const r = query.runSuiteQL({
        query: 'SELECT id FROM bom WHERE UPPER(name) = ? AND ROWNUM <= 1',
        params: [String(name).toUpperCase()]
      }).asMappedResults();
      return r.length ? Number(r[0].id) : null;
    } catch (e) {
      log.audit('BOM name lookup failed for "' + name + '"', e.message);
      return null;
    }
  };

  /** Read the subsidiary list off an existing BOM record. */
  const getBomSubsidiaries = (bomId) => {
    try {
      const bom = record.load({ type: record.Type.BOM, id: bomId, isDynamic: false });
      const v = bom.getValue({ fieldId: 'subsidiary' });
      if (Array.isArray(v)) return v;
      if (v === null || v === '') return null;
      return String(v).split(',').map((s) => s.trim()).filter((s) => s);
    } catch (e) {
      log.audit('Could not read subsidiaries off BOM ' + bomId, e.message);
      return null;
    }
  };

  /** Copy every component of an existing revision onto a new BOM, verbatim. */
  const cloneRevision = (srcRev, targetBomId) => {
    const revName = srcRev.getValue({ fieldId: 'name' });

    // If a prior attempt already cloned this revision onto this BOM, reuse it
    // rather than creating a duplicate.
    try {
      const dupe = query.runSuiteQL({
        query: 'SELECT id FROM bomrevision WHERE billofmaterials = ? AND UPPER(name) = ? AND ROWNUM <= 1',
        params: [targetBomId, String(revName).toUpperCase()]
      }).asMappedResults();
      if (dupe.length) {
        log.audit('Reusing existing revision ' + dupe[0].id + ' on BOM ' + targetBomId, revName);
        return Number(dupe[0].id);
      }
    } catch (e) {
      log.audit('Revision dupe check skipped', e.message);
    }

    const rev = record.create({ type: record.Type.BOM_REVISION, isDynamic: false });
    rev.setValue({ fieldId: 'billofmaterials', value: targetBomId });
    rev.setValue({ fieldId: 'name', value: revName });
    rev.setValue({ fieldId: 'effectivestartdate',
                   value: srcRev.getValue({ fieldId: 'effectivestartdate' }) });
    // deliberately no end date -- the child BOM is the live one going forward

    const s = 'component';
    const n = srcRev.getLineCount({ sublistId: s });
    if (!n) throw new Error('Source revision ' + srcRev.id + ' has no components.');

    for (let i = 0; i < n; i++) {
      ['item', 'bomquantity', 'componentyield', 'itemsource', 'units', 'description'].forEach((f) => {
        try {
          const v = srcRev.getSublistValue({ sublistId: s, fieldId: f, line: i });
          if (v !== null && v !== '') {
            rev.setSublistValue({ sublistId: s, fieldId: f, line: i, value: v });
          }
        } catch (e) { /* field not on this account's form */ }
      });
    }
    return rev.save({ ignoreMandatoryFields: true });
  };

  const endDateRevision = (revId, endDate) => {
    const rev = record.load({ type: record.Type.BOM_REVISION, id: revId, isDynamic: false });
    rev.setValue({ fieldId: 'effectiveenddate', value: endDate });
    rev.save({ ignoreMandatoryFields: true });
  };

  const createPowderRevision = (bomId, revName, startDate, childId, phantomId, hangers) => {
    const rev = record.create({ type: record.Type.BOM_REVISION, isDynamic: false });
    rev.setValue({ fieldId: 'billofmaterials', value: bomId });
    rev.setValue({ fieldId: 'name', value: revName });
    rev.setValue({ fieldId: 'effectivestartdate', value: startDate });

    setComponent(rev, 0, childId, 1, CFG.CHILD_ITEM_SOURCE);
    setComponent(rev, 1, phantomId, hangers, CFG.PHANTOM_ITEM_SOURCE);

    return rev.save({ ignoreMandatoryFields: true });
  };

  const setComponent = (rev, line, itemId, qty, source) => {
    const s = 'component';
    rev.setSublistValue({ sublistId: s, fieldId: 'item', line: line, value: itemId });
    rev.setSublistValue({ sublistId: s, fieldId: 'bomquantity', line: line, value: qty });
    rev.setSublistValue({ sublistId: s, fieldId: 'itemsource', line: line, value: source });
  };

  /** Strip everything down to the trailing revision letter: "101798 REV F" -> "F". */
  const revisionLetter = (revName) => {
    const m = String(revName || '').toUpperCase().match(/REV\s*[-]?\s*([A-Z0-9]{1,3})\s*$/);
    return m ? m[1] : 'A';
  };

  /**
   * Point an assembly item at exactly one BOM, as master default.
   *
   * If NetSuite rejects the BOM with INVALID_FLD_VALUE, the cause is almost
   * always that the BOM is not available to this assembly. Rather than fail
   * the part, open the BOM up to all assemblies and retry once -- the
   * assignment itself is what matters, and an over-broad availability flag is
   * a far smaller problem than a half-split part.
   */
  const replaceBoms = (itemId, bomId) => {
    const doAssign = () => {
      const item = record.load({ type: record.Type.ASSEMBLY_ITEM, id: itemId, isDynamic: true });
      const s = 'billofmaterials';
      for (let i = item.getLineCount({ sublistId: s }) - 1; i >= 0; i--) {
        item.removeLine({ sublistId: s, line: i });
      }
      item.selectNewLine({ sublistId: s });
      item.setCurrentSublistValue({ sublistId: s, fieldId: 'billofmaterials', value: bomId });
      item.setCurrentSublistValue({ sublistId: s, fieldId: 'masterdefault', value: true });
      item.commitLine({ sublistId: s });
      item.save({ ignoreMandatoryFields: true });
    };

    try {
      doAssign();
    } catch (e) {
      log.audit('BOM ' + bomId + ' rejected on item ' + itemId + '; opening availability and retrying',
                e.message);
      try {
        record.submitFields({
          type: record.Type.BOM,
          id: bomId,
          values: { availableforallassemblies: true },
          options: { ignoreMandatoryFields: true }
        });
      } catch (e2) {
        log.error('Could not open BOM ' + bomId + ' to all assemblies', e2.message);
      }
      doAssign();   // let it throw this time if it still fails
    }
  };

  const attachBom = (itemId, bomId, asMasterDefault) => {
    const item = record.load({ type: record.Type.ASSEMBLY_ITEM, id: itemId, isDynamic: true });
    const s = 'billofmaterials';
    const n = item.getLineCount({ sublistId: s });
    for (let i = 0; i < n; i++) {
      item.selectLine({ sublistId: s, line: i });
      if (String(item.getCurrentSublistValue({ sublistId: s, fieldId: 'billofmaterials' })) === String(bomId)) {
        if (asMasterDefault) {
          item.setCurrentSublistValue({ sublistId: s, fieldId: 'masterdefault', value: true });
          item.commitLine({ sublistId: s });
        }
        item.save({ ignoreMandatoryFields: true });
        return;
      }
    }
    item.selectNewLine({ sublistId: s });
    item.setCurrentSublistValue({ sublistId: s, fieldId: 'billofmaterials', value: bomId });
    if (asMasterDefault) item.setCurrentSublistValue({ sublistId: s, fieldId: 'masterdefault', value: true });
    item.commitLine({ sublistId: s });
    item.save({ ignoreMandatoryFields: true });
  };

  // ------------------------------------------------------- routing plumbing
  /**
   * Move the live fab routing(s) off the parent BOM and onto the child BOM.
   * Inactive routings and other subsidiaries (the "-TECH_ONLY" leftovers on
   * subsidiary 4 / location 16) are deliberately left alone.
   */
  const repointRoutings = (fromBomId, toBomId) => {
    const rows = query.runSuiteQL({
      query: 'SELECT id, name FROM manufacturingrouting ' +
             "WHERE billofmaterials = ? AND isinactive = 'F' AND subsidiary = ?",
      params: [fromBomId, CFG.SUBSIDIARY]
    }).asMappedResults();

    const moved = [];
    rows.forEach((r) => {
      record.submitFields({
        type: record.Type.MANUFACTURING_ROUTING,
        id: r.id,
        values: { billofmaterials: toBomId },
        options: { ignoreMandatoryFields: true }
      });
      moved.push(r.id + ' (' + r.name + ')');
    });
    return moved;
  };

  const createRouting = (parentName, bomId, runRate) => {
    const rt = record.create({ type: record.Type.MANUFACTURING_ROUTING, isDynamic: false });
    rt.setValue({ fieldId: 'name', value: parentName + ' ROUTING' });
    rt.setValue({ fieldId: 'billofmaterials', value: bomId });
    rt.setValue({ fieldId: 'subsidiary', value: CFG.SUBSIDIARY });
    rt.setValue({ fieldId: 'location', value: CFG.LOCATION });
    rt.setValue({ fieldId: 'isdefault', value: true });
    rt.setValue({ fieldId: 'autocalculatelag', value: false });

    const s = 'routingstep';
    rt.setSublistValue({ sublistId: s, fieldId: 'operationsequence', line: 0, value: CFG.PC_OP_SEQ });
    rt.setSublistValue({ sublistId: s, fieldId: 'operationname', line: 0, value: CFG.PC_OP_NAME });
    rt.setSublistValue({ sublistId: s, fieldId: 'manufacturingworkcenter', line: 0, value: CFG.PC_WORKCENTER });
    rt.setSublistValue({ sublistId: s, fieldId: 'manufacturingcosttemplate', line: 0, value: CFG.PC_COST_TEMPLATE });
    rt.setSublistValue({ sublistId: s, fieldId: 'setuptime', line: 0, value: CFG.PC_SETUP_TIME });
    rt.setSublistValue({ sublistId: s, fieldId: 'runrate', line: 0, value: runRate });

    return rt.save({ ignoreMandatoryFields: true });
  };

  // ---------------------------------------------------------------- helpers
  const parseDate = (mdy) => {
    if (mdy) {
      try { return format.parse({ value: mdy, type: format.Type.DATE }); }
      catch (e) { log.audit('Bad cutover date, using today', mdy); }
    }
    return new Date();
  };

  const addDays = (d, n) => {
    const out = new Date(d.getTime());
    out.setDate(out.getDate() + n);
    return out;
  };

  // -------------------------------------------------------------- summarize
  const summarize = (ctx) => {
    const ok = [], failed = [];
    ctx.output.iterator().each((key, value) => {
      const r = JSON.parse(value);
      (r.ok ? ok : failed).push(r);
      return true;
    });

    try {
      ctx.mapSummary.errors.iterator().each((k, e) => { log.error('Unhandled map error ' + k, e); return true; });
    } catch (e) { /* no errors collection */ }

    log.audit('Powder split finished', { succeeded: ok.length, failed: failed.length });

    const lines = ['POWDER COAT SPLIT RESULTS',
                   'Succeeded: ' + ok.length + '   Failed: ' + failed.length, ''];
    ok.forEach((r) => {
      const c = r.created;
      lines.push('OK  ' + r.partNumber);
      lines.push('      parent  ' + c.parentName + '  (item ' + c.parentId + ')');
      lines.push('      child   ' + c.childName + '  (item ' + c.childId + ')');
      lines.push('      parent BOM ' + c.parentBomId + '  new rev ' + c.parentRevisionId +
                 ' "' + c.parentRevisionName + '"');
      if (c.childBomId) lines.push('      child BOM  ' + c.childBomId + '  rev ' + c.childRevisionId);
      if (c.routingsRepointed && c.routingsRepointed.length) {
        lines.push('      repointed  ' + c.routingsRepointed.join(', '));
      }
      lines.push('      powder routing ' + c.routingId);
      (r.notes || []).forEach((n) => lines.push('      ! ' + n));
    });
    failed.forEach((r) => lines.push('FAIL ' + r.partNumber + ': ' + r.error));

    const body = lines.join('\n');
    log.audit('Summary', body);

    if (CFG.EMAIL_SUMMARY) {
      try {
        const me = runtime.getCurrentUser().id;
        email.send({
          author: me, recipients: me,
          subject: 'Powder coat split: ' + ok.length + ' ok, ' + failed.length + ' failed',
          body: body
        });
      } catch (e) {
        log.error('Summary email failed', e);
      }
    }
  };

  return { getInputData, map, summarize };
});
