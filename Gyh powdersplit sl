/**
 * GYH_PowderSplit_SL.js
 *
 * GEN-Y HITCH - Add Powder Coat Step to Parts
 * -------------------------------------------
 * Suitelet UI. Takes a list of part numbers + color + hanger qty, validates
 * everything read-only, then hands the write work to GYH_PowderSplit_MR.js.
 *
 * Follows the 101798 cutover pattern (PROD, 08/04/2026):
 *
 *   ITEM   101798  is renamed to  101798 - SV  and gains " SILVER VEIN" on its
 *          display name. Same internal ID, so inventory, transaction history,
 *          where-used, open POs and SOs all stay attached to it. It is now the
 *          coated finished good.
 *   ITEM   a copy is created under the original number 101798 -- the bare
 *          child, starting at zero on hand.
 *   BOM    the existing BOM record is RENAMED to "101798 - SV BOM" and stays
 *          on the parent, so historical WOs still resolve to the BOM they were
 *          built against. Its live revision is end-dated and a new revision
 *          "101798 - SV BOM REV <letter>" is added:
 *              101798                                     x 1    WORK_ORDER
 *              PRIME AND POWDER COAT <color> (PER HANGER)  x n    PHANTOM
 *   BOM    a NEW BOM "101798 BOM" is created for the child, holding a clone of
 *          the last fab revision -- same revision name, original effective
 *          start date, no end date.
 *   ROUTE  the live fab routing is REPOINTED from the parent BOM to the child
 *          BOM (same record, same name, same steps). Inactive "-TECH_ONLY"
 *          routings on subsidiary 4 are left alone.
 *   ROUTE  a NEW routing "101798 - SV ROUTING" is created on the parent BOM
 *          with a single op: seq 9, POWDERCOAT, Hitch - Powder Coating,
 *          PRIME AND POWDER-COAT (COST PER HANGER).
 *
 * UI: built as an N/ui/serverWidget Form with a single INLINEHTML field
 * carrying the whole dashboard (markup + scoped CSS + JS), rendered via
 * response.writePage(). Nothing is written to the response as raw HTML.
 *
 * @NApiVersion 2.1
 * @NScriptType Suitelet
 * @NModuleScope SameAccount
 */
define(['N/ui/serverWidget', 'N/query', 'N/task', 'N/runtime', 'N/log'],
(serverWidget, query, task, runtime, log) => {

  // ---------------------------------------------------------------- config
  const CFG = {
    SUFFIX: ' - SV',                       // exactly as used in PROD
    PHANTOM_PREFIX: 'PRIME AND POWDER',
    DEFAULT_HANGERS: 0.5,
    // Hanger qty drives BOTH the phantom BOM quantity and the routing run
    // rate. They are the same number by definition -- one hanger of capacity
    // consumed per hanger of powder. Keeping them as one field is what stops
    // the 1-vs-0.5 drift found on 125 already-split parts.
    SUBSIDIARY: 2,
    MAX_ROWS: 100,

    WRAPPER_ID: 'gyhPowderSplit',          // every custom CSS/JS rule is scoped under this

    MR_SCRIPT_ID: 'customscript5496',      // confirmed on the Script record in SB2 08/2026
    MR_DEPLOY_ID: 'customdeploy1',         // confirmed on the Deployment record in SB2 08/2026
    MR_PARAM: 'custscript_gyh_pcs_payload'
  };

  // ------------------------------------------------------------ entry point
  const onRequest = (ctx) => {
    const req = ctx.request, res = ctx.response;

    if (req.method === 'GET') { res.writePage(buildForm()); return; }

    res.setHeader({ name: 'Content-Type', value: 'application/json' });
    let out;
    try {
      const body = JSON.parse(req.body || '{}');
      if (body.action === 'validate') out = { ok: true, rows: validateRows(body.rows || [], body.cutoverDate) };
      else if (body.action === 'commit') out = commit(body.rows || [], body.cutoverDate);
      else out = { ok: false, error: 'Unknown action' };
    } catch (e) {
      log.error('POST failed', e);
      out = { ok: false, error: e.message || String(e) };
    }
    res.write(JSON.stringify(out));
  };

  // ---------------------------------------------------------- form / widget
  const buildForm = () => {
    const form = serverWidget.createForm({ title: 'Add Powder Coat Step to Parts' });

    const field = form.addField({
      id: 'custpage_gyh_powdersplit_html',
      type: serverWidget.FieldType.INLINEHTML,
      label: 'Dashboard'
    });
    field.updateLayoutType({ layoutType: serverWidget.FieldLayoutType.OUTSIDEBELOW });
    field.updateBreakType({ breakType: serverWidget.FieldBreakType.STARTROW });
    field.defaultValue = renderPage();

    return form;
  };

  // ------------------------------------------------------------- validation
  const validateRows = (rows, cutoverDate) => {
    rows = rows.slice(0, CFG.MAX_ROWS);
    if (!rows.length) return [];

    // look up the part and its future " - SV" name, to catch re-runs
    const names = [];
    rows.forEach((r) => {
      const p = String(r.partNumber || '').trim();
      if (p) { names.push(p.toUpperCase()); names.push((p + CFG.SUFFIX).toUpperCase()); }
    });

    const itemsByName = {}, itemsById = {};
    if (names.length) {
      const ph = names.map(() => '?').join(',');
      query.runSuiteQL({
        query: 'SELECT id, itemid, displayname, itemtype, isinactive, costestimatetype ' +
               'FROM item WHERE UPPER(itemid) IN (' + ph + ')',
        params: names
      }).asMappedResults().forEach((i) => {
        itemsByName[String(i.itemid).trim().toUpperCase()] = i;
        itemsById[String(i.id)] = i;
      });
    }

    const ids = Object.keys(itemsById);

    // master-default BOM + its current revision
    const bomByItem = {};
    if (ids.length) {
      const ph = ids.map(() => '?').join(',');
      try {
        query.runSuiteQL({
          query: 'SELECT ab.assembly, ab.billofmaterials, b.name AS bomname, ' +
                 'ab.currentrevision, r.name AS revname, r.effectivestartdate ' +
                 'FROM itemAssemblyItemBom ab ' +
                 'JOIN bom b ON b.id = ab.billofmaterials ' +
                 'LEFT JOIN bomrevision r ON r.id = ab.currentrevision ' +
                 "WHERE ab.masterdefault = 'T' AND ab.assembly IN (" + ph + ')',
          params: ids
        }).asMappedResults().forEach((b) => { bomByItem[String(b.assembly)] = b; });
      } catch (e) {
        log.audit('BOM lookup skipped', e.message);
      }
    }

    // live routings that will be repointed to the child BOM
    const routingsByBom = {};
    const bomIds = Object.keys(bomByItem).map((k) => bomByItem[k].billofmaterials);
    if (bomIds.length) {
      const ph = bomIds.map(() => '?').join(',');
      try {
        query.runSuiteQL({
          query: 'SELECT billofmaterials, id, name FROM manufacturingrouting ' +
                 "WHERE isinactive = 'F' AND subsidiary = " + CFG.SUBSIDIARY +
                 ' AND billofmaterials IN (' + ph + ')',
          params: bomIds
        }).asMappedResults().forEach((r) => {
          const k = String(r.billofmaterials);
          (routingsByBom[k] = routingsByBom[k] || []).push(r.name);
        });
      } catch (e) {
        log.audit('Routing lookup skipped', e.message);
      }
    }

    // open WOs -> warning only
    const openWoByItem = {};
    if (ids.length) {
      const ph = ids.map(() => '?').join(',');
      try {
        query.runSuiteQL({
          query: 'SELECT tl.item, COUNT(*) AS cnt FROM transaction t ' +
                 'JOIN transactionline tl ON tl.transaction = t.id ' +
                 "WHERE t.type = 'WorkOrd' AND t.status NOT IN ('WorkOrd:G','WorkOrd:H') " +
                 "AND tl.mainline = 'T' AND tl.item IN (" + ph + ') GROUP BY tl.item',
          params: ids
        }).asMappedResults().forEach((w) => { openWoByItem[String(w.item)] = Number(w.cnt); });
      } catch (e) {
        log.audit('Open WO lookup skipped', e.message);
      }
    }

    const colorIds = {};
    getColors().forEach((c) => { colorIds[String(c.id)] = c; });

    return rows.map((r) => {
      const part = String(r.partNumber || '').trim();
      const color = colorIds[String(r.phantomItemId)];
      const out = {
        partNumber: part,
        parentName: part + CFG.SUFFIX,
        phantomItemId: r.phantomItemId,
        colorLabel: color ? colorLabel(color.itemid) : '',
        hangers: Number(r.hangers) || CFG.DEFAULT_HANGERS,
        cutoverDate: cutoverDate || '',
        itemInternalId: null,
        fabBomId: null, fabBomName: null, fabRevId: null, fabRevName: null,
        newRevName: null, routings: [],
        status: 'ok', messages: []
      };
      const err = (m) => { out.status = 'error'; out.messages.push(m); };
      const warn = (m) => { if (out.status !== 'error') out.status = 'warn'; out.messages.push(m); };

      if (!part) { err('Part number is blank.'); return out; }

      const item = itemsByName[part.toUpperCase()];
      if (!item) { err('No item found with this name/number.'); return out; }
      out.itemInternalId = item.id;

      if (String(item.itemtype) !== 'Assembly') {
        err('Item type is ' + item.itemtype + '. Only Assembly items can be split.');
      }
      if (String(item.isinactive) === 'T') err('Item is inactive.');
      if (part.toUpperCase().endsWith(CFG.SUFFIX.trim().toUpperCase())) {
        err('Already ends in "' + CFG.SUFFIX.trim() + '" -- looks like it was split already.');
      }
      const clash = itemsByName[out.parentName.toUpperCase()];
      if (clash) err('"' + out.parentName + '" already exists (internal ID ' + clash.id + ').');

      const bom = bomByItem[String(item.id)];
      if (bom) {
        out.fabBomId = bom.billofmaterials;
        out.fabBomName = bom.bomname;
        out.fabRevId = bom.currentrevision;
        out.fabRevName = bom.revname;
        out.newRevName = out.parentName + ' BOM REV ' + revLetter(bom.revname);
        out.routings = routingsByBom[String(bom.billofmaterials)] || [];
        if (!bom.currentrevision) err('BOM "' + bom.bomname + '" has no current revision to clone.');
        if (!out.routings.length) {
          warn('No active subsidiary-' + CFG.SUBSIDIARY + ' routing on this BOM, so nothing will be repointed.');
        }
      } else {
        warn('No master-default BOM. A powder BOM will be built from scratch and the child will have none.');
      }

      if (!color) err('Pick a color.');
      if (!(out.hangers > 0)) err('Hanger qty must be greater than zero.');

      const wo = openWoByItem[String(item.id)];
      if (wo) warn(wo + ' open WO(s) on this item -- travelers already printed will show the old number.');

      return out;
    });
  };

  // ----------------------------------------------------------------- commit
  const commit = (rows, cutoverDate) => {
    const validated = validateRows(rows, cutoverDate);
    const bad = validated.filter((r) => r.status === 'error');
    if (bad.length) return { ok: false, error: bad.length + ' row(s) still have errors. Re-validate.' };
    if (!validated.length) return { ok: false, error: 'Nothing to process.' };

    const payload = validated.map((r) => ({
      partNumber: r.partNumber,
      itemInternalId: r.itemInternalId,
      parentName: r.parentName,
      phantomItemId: r.phantomItemId,
      colorLabel: r.colorLabel,
      hangers: r.hangers,          // MR uses this for BOM qty and run rate alike
      fabBomId: r.fabBomId,
      fabRevId: r.fabRevId,
      cutoverDate: cutoverDate || ''
    }));

    const t = task.create({ taskType: task.TaskType.MAP_REDUCE });
    t.scriptId = CFG.MR_SCRIPT_ID;
    t.deploymentId = CFG.MR_DEPLOY_ID;
    t.params = {};
    t.params[CFG.MR_PARAM] = JSON.stringify(payload);

    const taskId = t.submit();
    log.audit('Powder split queued', { taskId: taskId, count: payload.length, user: runtime.getCurrentUser().id });
    return { ok: true, taskId: taskId, count: payload.length };
  };

  // ----------------------------------------------------------------- colors
  const getColors = () => {
    try {
      return query.runSuiteQL({
        query: 'SELECT id, itemid, displayname FROM item ' +
               "WHERE UPPER(itemid) LIKE ? AND isinactive = 'F' AND itemtype = 'Assembly' " +
               'ORDER BY itemid',
        params: [CFG.PHANTOM_PREFIX + '%']
      }).asMappedResults();
    } catch (e) {
      log.error('Color lookup failed', e);
      return [];
    }
  };

  /** "PRIME AND POWDER COAT SILVER VEIN (PER HANGER)" -> "SILVER VEIN" */
  const colorLabel = (itemid) => String(itemid || '')
    .toUpperCase()
    .replace(/^PRIME\s+AND\s+POWDER\s*-?\s*COAT\s*/, '')
    .replace(/\(PER\s+HANGER\)/, '')
    .replace(/\s+/g, ' ')
    .trim();

  /** "101798 REV F" -> "F" */
  const revLetter = (revName) => {
    const m = String(revName || '').toUpperCase().match(/REV\s*-?\s*([A-Z0-9]{1,3})\s*$/);
    return m ? m[1] : 'A';
  };

  // ------------------------------------------------------------------- view
  // Returns ONLY the scoped fragment that goes into the INLINEHTML field --
  // no <html>/<head>/<body>. Everything is nested inside #WRAPPER_ID so the
  // CSS/JS can't touch anything outside it, and the only thing reaching
  // outside that div is the one rule that hides NetSuite's own title band.
  const renderPage = () => {
    const colors = getColors().map((c) => ({ id: c.id, label: c.itemid }));
    const W = CFG.WRAPPER_ID;

    return '<style>' + css(W) + '</style>' +
      '<div id="' + W + '">' +
        '<header><h1>Add Powder Coat Step to Parts</h1>' +
        '<p class="sub">Renames each part to <code>&lt;part&gt;' + esc(CFG.SUFFIX) + '</code> as the ' +
        'coated parent, copies it back out under the original number as the bare child, then rebuilds ' +
        'the BOMs and routings the same way 101798 was done.</p></header>' +

        '<section class="card">' +
          '<h2>1 &middot; Load part numbers</h2>' +
          '<div class="bulk">' +
            '<textarea id="bulk" rows="4" placeholder="Paste part numbers, one per line&#10;101798&#10;106064&#10;107169"></textarea>' +
            '<div class="bulkside">' +
              '<label>Default color</label><select id="defColor"></select>' +
              '<label>Default hangers / unit</label>' +
              '<input id="defHangers" type="number" step="0.01" min="0" value="' + CFG.DEFAULT_HANGERS + '">' +
              '<button class="btn" onclick="gyhPS_addBulk()">Add to grid</button>' +
            '</div>' +
          '</div>' +
        '</section>' +

        '<section class="card">' +
          '<div class="cardhead"><h2>2 &middot; Review rows</h2>' +
            '<div><button class="btn ghost" onclick="gyhPS_addRow()">+ Row</button>' +
            '<button class="btn ghost" onclick="gyhPS_clearRows()">Clear</button></div></div>' +
          '<table><thead><tr>' +
            '<th style="width:15%">Part number</th>' +
            '<th style="width:14%">Becomes parent</th>' +
            '<th style="width:26%">Color (phantom)</th>' +
            '<th style="width:10%">Hangers / unit</th>' +
            '<th>Status</th><th style="width:30px"></th>' +
          '</tr></thead><tbody id="body"></tbody></table>' +
          '<p class="hint">One number, used for both the phantom BOM quantity and the ' +
          'POWDERCOAT operation run rate &mdash; they are the same thing by definition.</p>' +
        '</section>' +

        '<section class="card">' +
          '<h2>3 &middot; Validate, then commit</h2>' +
          '<div class="actions">' +
            '<label class="inline">Cutover date <input id="cutover" type="text" placeholder="m/d/yyyy" style="width:110px"></label>' +
            '<button class="btn" id="btnVal" onclick="gyhPS_doValidate()">Validate (read only)</button>' +
            '<button class="btn go" id="btnGo" onclick="gyhPS_doCommit()" disabled>Commit split</button>' +
            '<span id="msg" class="msg"></span>' +
          '</div>' +
          '<p class="hint">The old fab revision is end-dated the day before the cutover date and the ' +
          'new powder revision starts on it.</p>' +
          '<p class="warn"><b>This cannot be undone from here.</b> Run it in SB2 first. ' +
          'On-hand stays on the parent, which is now the coated <code>' + esc(CFG.SUFFIX.trim()) +
          '</code> item, and the child starts at zero &mdash; move stock by hand if what is physically ' +
          'on the shelf is bare. Vendor records and purchase prices also stay on the parent.</p>' +
        '</section>' +
      '</div>' +
      '<script>(function(){' +
      'var COLORS=' + JSON.stringify(colors) + ';var SUFFIX=' + JSON.stringify(CFG.SUFFIX) +
      ';var MAXROWS=' + CFG.MAX_ROWS + ';var WRAP=' + JSON.stringify(W) + ';' +
      clientJs() + '})();</script>';
  };

  // All lookups are scoped to the wrapper div (ROOT), never bare
  // document.getElementById, so nothing here can touch or be shadowed by
  // NetSuite's own page elements. The five entry points referenced from
  // inline onclick= attributes are hung on window with a gyhPS_ prefix so
  // they resolve from outside this IIFE's closure; everything else stays
  // private inside it.
  const clientJs = () => [
    'var ROOT=document.getElementById(WRAP);',
    'function $(sel){return ROOT.querySelector(sel);}',

    'function colorOpts(sel){var s="<option value=\'\'>-- select --</option>";',
    'for(var i=0;i<COLORS.length;i++){s+="<option value=\'"+COLORS[i].id+"\'"+',
    '(String(sel)===String(COLORS[i].id)?" selected":"")+">"+COLORS[i].label+"</option>";}return s;}',

    '$("#defColor").innerHTML=colorOpts("");',
    '(function(){var d=new Date();$("#cutover").value=',
    '(d.getMonth()+1)+"/"+d.getDate()+"/"+d.getFullYear();})();',

    'function addRow(part,color,hangers){var tb=$("#body");',
    'if(tb.rows.length>=MAXROWS){alert("Max "+MAXROWS+" rows per run.");return;}',
    'var tr=tb.insertRow();tr.innerHTML=',
    '"<td><input class=\'p\' value=\'"+(part||"")+"\' oninput=\'gyhPS_syncName(this)\'></td>"+',
    '"<td class=\'pn mono\'>"+(part?part+SUFFIX:"")+"</td>"+',
    '"<td><select class=\'c\'>"+colorOpts(color)+"</select></td>"+',
    '"<td><input class=\'h\' type=\'number\' step=\'0.01\' min=\'0\' value=\'"+(hangers||"")+"\'></td>"+',
    '"<td class=\'st\'></td>"+',
    '"<td><button class=\'x\' onclick=\'gyhPS_removeRow(this)\'>&times;</button></td>";',
    'dirty();}',

    'function removeRow(btn){btn.closest("tr").remove();dirty();}',

    'function syncName(el){var tr=el.closest("tr");var v=el.value.trim();',
    'tr.querySelector(".pn").textContent=v?v+SUFFIX:"";dirty();}',

    'function addBulk(){var txt=$("#bulk").value;',
    'var c=$("#defColor").value;',
    'var h=$("#defHangers").value;',
    'var lines=txt.split(/[\\r\\n,;\\t]+/);var n=0;',
    'for(var i=0;i<lines.length;i++){var p=lines[i].trim();if(p){addRow(p,c,h);n++;}}',
    '$("#bulk").value="";',
    'if(!n)setMsg("Nothing to add.","e");else setMsg(n+" row(s) added.","");}',

    'function clearRows(){$("#body").innerHTML="";dirty();}',

    'function collect(){var out=[];var rows=$("#body").rows;',
    'for(var i=0;i<rows.length;i++){var t=rows[i];out.push({partNumber:t.querySelector(".p").value.trim(),',
    'phantomItemId:t.querySelector(".c").value,',
    'hangers:t.querySelector(".h").value});}return out;}',

    'function dirty(){$("#btnGo").disabled=true;}',
    'function setMsg(m,k){var e=$("#msg");e.textContent=m;e.className="msg "+(k||"");}',

    'function post(body,cb){var b=$("#btnVal"),g=$("#btnGo");',
    'b.disabled=true;g.disabled=true;',
    'fetch(window.location.href,{method:"POST",headers:{"Content-Type":"application/json"},',
    'body:JSON.stringify(body)}).then(function(r){return r.json();}).then(function(d){b.disabled=false;cb(d);})',
    '.catch(function(e){b.disabled=false;setMsg("Request failed: "+e,"e");});}',

    'function plan(r){var p=[];',
    'if(r.fabBomName){p.push("BOM <span class=\'mono\'>"+r.fabBomName+"</span> renamed, rev <span class=\'mono\'>"',
    '+(r.fabRevName||"?")+"</span> closed, <span class=\'mono\'>"+r.newRevName+"</span> added");',
    'p.push("child BOM <span class=\'mono\'>"+r.partNumber+" BOM</span> cloned from it");}',
    'if(r.routings&&r.routings.length){p.push("repoint "+r.routings.length+" routing: <span class=\'mono\'>"',
    '+r.routings.join(", ")+"</span>");}',
    'p.push("new <span class=\'mono\'>"+r.parentName+" ROUTING</span> @ run rate "+r.hangers);',
    'return "<div class=\'plan\'>"+p.join(" &middot; ")+"</div>";}',

    'function doValidate(){var rows=collect();if(!rows.length){setMsg("Add some part numbers first.","e");return;}',
    'setMsg("Validating...","");',
    'post({action:"validate",rows:rows,cutoverDate:$("#cutover").value},function(d){',
    'if(!d.ok){setMsg(d.error||"Validation failed.","e");return;}',
    'var tb=$("#body").rows;var errs=0,warns=0;',
    'for(var i=0;i<d.rows.length;i++){var r=d.rows[i];var cell=tb[i].querySelector(".st");',
    'if(r.status==="error"){errs++;cell.innerHTML="<span class=\'bad\'>ERROR</span> "+r.messages.join(" ");}',
    'else if(r.status==="warn"){warns++;cell.innerHTML="<span class=\'wrn\'>CHECK</span> "+r.messages.join(" ")+plan(r);}',
    'else{cell.innerHTML="<span class=\'good\'>READY</span>"+plan(r);}}',
    'if(errs){setMsg(errs+" error(s) -- fix before committing.","e");}',
    'else{$("#btnGo").disabled=false;',
    'setMsg("Ready: "+d.rows.length+" part(s)"+(warns?", "+warns+" with warnings":"")+".","g");}});}',

    'function doCommit(){var rows=collect();',
    'if(!confirm("Split "+rows.length+" part(s)? This renames live item and BOM records and cannot be undone here."))return;',
    'setMsg("Submitting...","");',
    'post({action:"commit",rows:rows,cutoverDate:$("#cutover").value},function(d){',
    'if(!d.ok){setMsg(d.error||"Commit failed.","e");return;}',
    'setMsg("Queued "+d.count+" part(s). Map/Reduce task "+d.taskId+". Watch the Script Execution Log.","g");});}',

    // exposed entry points for the inline onclick= handlers in the markup above
    'window.gyhPS_addRow=function(){addRow();};',
    'window.gyhPS_addBulk=addBulk;',
    'window.gyhPS_clearRows=clearRows;',
    'window.gyhPS_removeRow=removeRow;',
    'window.gyhPS_syncName=syncName;',
    'window.gyhPS_doValidate=doValidate;',
    'window.gyhPS_doCommit=doCommit;',

    'addRow();'
  ].join('');

  // All selectors are prefixed with #WRAPPER_ID so nothing here can leak
  // onto or collide with the surrounding NetSuite page. The one exception
  // is .uir-page-title, which is NetSuite's own page-title band -- that
  // single global rule just hides it for a cleaner look; nothing else
  // outside the wrapper is touched.
  const css = (w) => [
    '.uir-page-title{display:none}',

    '#' + w + '{box-sizing:border-box;font:13px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;',
    'background:#f4f5f7;color:#1f2430;max-width:1240px;margin:0 auto;padding:20px}',
    '#' + w + ' *{box-sizing:border-box}',
    '#' + w + ' header h1{margin:0 0 4px;font-size:21px}',
    '#' + w + ' header .sub{margin:0 0 18px;color:#667;max-width:900px}',
    '#' + w + ' .card{background:#fff;border:1px solid #e2e5ea;border-radius:8px;padding:16px;margin-bottom:14px}',
    '#' + w + ' .card h2{margin:0 0 12px;font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:#5a6474}',
    '#' + w + ' .cardhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}',
    '#' + w + ' .cardhead h2{margin:0}',
    '#' + w + ' .bulk{display:flex;gap:14px}',
